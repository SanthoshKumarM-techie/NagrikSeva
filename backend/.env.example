PORT=5000
NODE_ENV=development

# Database Configuration (Option B: Individual Parameters)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nagrikseva
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DATABASE_SSL=false

# Optional / Full Connection URL (can be used as an alternative)
